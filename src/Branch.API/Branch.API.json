        "required": [
          "name",
          "address",
          "phone",
          "isActive",
          "displayOrder"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "address": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "displayOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "taxNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "receiptFooter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "dayStartTime": {
            "type": [
              "null",
              "string"
            ]
          },
          "dayEndTime": {
            "type": [
              "null",
              "string"
            ]
          },
          "isOrderingEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "isReservationsEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "requireSignInForTableOrders": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "UpdateBranchSettingsRequest": {
        "type": "object",
        "properties": {
          "isOrderingEnabled": {
