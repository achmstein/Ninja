# The edge on a laptop: the production routing with Caddy's own local CA
# issuing an exact certificate per host on its first connection. Keycloak
# only sets Secure cookies, so plain http cannot sign anyone in; trust the
# CA once (see README). Browsers reject a wildcard directly under a
# top-level name (*.localhost), so no wildcard site addresses here: one
# catch-all site with host matchers, and the control plane confirms each
# host is one of ours before a certificate is issued, as in production.
# {labels.1} is the slug in admin.cove.localhost (labels.0 = localhost).

{
	local_certs
	on_demand_tls {
		ask http://control-api:8080/api/control/tls/ask
	}
}

(spa) {
	root * {args[0]}
	try_files {path} /index.html
	encode zstd gzip
	file_server
	header Cache-Control "no-cache"
}

# Where a tenant's stack answers, in {tenant_upstream}: its gateway by container name on
# this box, or the ingress of the node it runs on when tenant-routes.caddy names one.
# The control plane writes that file (one "slug host:port" a line) and reloads, as it
# does custom-domains.caddy. args: the tenant's slug
(tenant_upstream) {
	map {args[0]} {tenant_upstream} {
		import tenant-routes.caddy
		default {args[0]}-gateway:5000
	}
	vars tenant_slug {args[0]}
}

(tenant_api) {
	# args: the tenant's slug
	import tenant_upstream {args[0]}
	handle /api/* {
		# The menu's JSON compresses five to ten times; the live hub below is left as it is
		encode zstd gzip
		reverse_proxy {tenant_upstream} {
			header_up X-Ninja-Tenant {vars.tenant_slug}
		}
	}
	handle /hub/* {
		reverse_proxy {tenant_upstream} {
			header_up X-Ninja-Tenant {vars.tenant_slug}
		}
	}
}

(app_links) {
	handle /.well-known/assetlinks.json {
		rewrite * /api/control/app-links/assetlinks.json
		reverse_proxy control-api:8080
	}
	handle /.well-known/apple-app-site-association {
		rewrite * /api/control/app-links/apple-app-site-association
		reverse_proxy control-api:8080
	}
}

https:// {
	tls {
		on_demand
	}

	# A stack that is off (suspended for non-payment, or stopped) answers nothing: say so,
	# as JSON the apps recognise, instead of a bare 502
	handle_errors 502 503 {
		@apipath path /api/* /hub/*
		handle @apipath {
			header Content-Type application/json
			respond `{"code":"paused"}` 503
		}
	}

	@root host localhost
	handle @root {
		# The native apps' download page, as the platform serves it (deploy/platform/apps)
		handle_path /apps* {
			root * /srv/apps
			file_server
			header Cache-Control "no-cache"
			# Android installs what it is told is a package; an unknown type would just be a file
			@apk path *.apk
			header @apk Content-Type application/vnd.android.package-archive
		}
		handle {
			redir https://control.localhost{uri}
		}
	}

	@auth host auth.localhost
	handle @auth {
		# "Sign in as the owner": the owner's session cookies, handed over on this host
		handle /api/control/impersonate/* {
			reverse_proxy control-api:8080
		}
		# Apple's form post to the hub, turned into the GET Keycloak's broker takes
		@applepost {
			method POST
			path /realms/ninja-hub/broker/apple/endpoint
		}
		handle @applepost {
			rewrite * /api/control/social/apple
			reverse_proxy control-api:8080
		}
		handle {
			reverse_proxy keycloak:8080
		}
	}

	@control host control.localhost
	handle @control {
		handle /api/* {
			reverse_proxy control-api:8080
		}
		handle {
			import spa /srv/control-web
		}
	}

	@admin host admin.*.localhost
	handle @admin {
		import tenant_api {labels.1}
		handle {
			import spa /srv/admin-web
		}
	}

	@pos host pos.*.localhost
	handle @pos {
		import tenant_api {labels.1}
		handle {
			import spa /srv/pos-web
		}
	}

	@kds host kds.*.localhost
	handle @kds {
		import tenant_api {labels.1}
		handle {
			import spa /srv/kds-web
		}
	}

	@api host api.*.localhost
	handle @api {
		import tenant_upstream {labels.1}
		reverse_proxy {tenant_upstream} {
			header_up X-Ninja-Tenant {vars.tenant_slug}
		}
	}

	# The customer app on the platform host is the catch-all; only the
	# control app and the café's own admin may frame it (their live brand previews)
	@customer host *.localhost
	handle @customer {
		header Content-Security-Policy "frame-ancestors 'self' https://control.localhost https://admin.{host}"
		import tenant_api {labels.1}
		# A business's own app's link files, from its record (deploy/platform/Caddyfile)
		import app_links
		handle {
			import spa /srv/client-web
		}
	}
}
