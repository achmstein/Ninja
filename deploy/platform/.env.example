# The platform's shared secrets and its domain. Copy to .env and fill in.

# Tenants hang off this: {slug}.DOMAIN, admin.{slug}.DOMAIN, auth.DOMAIN, control.DOMAIN
PLATFORM_DOMAIN=ninja.app
# Which host label is the slug, counted from the right: 2 for a two-label
# domain (ninja.app), 3 for a three-label one (ninja.co.uk)
PLATFORM_SLUG_LABEL=2
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=
EVENTBUS_PASSWORD=
KEYCLOAK_PASSWORD=

# Optional: the assistant in every stack
GEMINI_API_KEY=

IMAGE_REGISTRY=ghcr.io/achmstein/ninja
IMAGE_TAG=latest
