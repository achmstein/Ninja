# The platform's shared secrets and its domain. Copy to .env and fill in.

# Tenants hang off this: {slug}.DOMAIN, admin.{slug}.DOMAIN, auth.DOMAIN, control.DOMAIN
PLATFORM_DOMAIN=ninja.app
# Which host label is the slug, counted from the right: 2 for a two-label
# domain (ninja.app), 3 for a three-label one (ninja.co.uk)
PLATFORM_SLUG_LABEL=2
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=
EVENTBUS_PASSWORD=
KEYCLOAK_PASSWORD=
# The control plane's own Postgres role (owns controldb, nothing else)
CONTROL_DB_PASSWORD=
# The control plane's own Keycloak user in the master realm (the deploy
# workflow creates it with the admin role); the bootstrap admin above is then
# only for people
KEYCLOAK_CONTROL_USER=platform-control
KEYCLOAK_CONTROL_PASSWORD=
# What the tenants' secrets (database and broker passwords, realm client
# secrets, the owner's first password) are encrypted under in controldb:
#   openssl rand -base64 32
# Keep it with the backups: without it a restored controldb has no secrets.
PLATFORM_ENCRYPTION_KEY=
# Where the Keycloak admin console (auth.DOMAIN/admin/*) may be opened from:
# space-separated networks. Nowhere until set.
ADMIN_ALLOW_CIDR=

# Optional: the assistant. The key reaches only the stacks whose plan is
# listed (a demo always gets it); the rest run with the assistant off.
GEMINI_API_KEY=
ASSISTANT_PLAN_0=Pro

# Optional: social sign-in. One Google app and one Apple app for the whole
# platform, not one per café: a café would need its own paid Apple account and
# a walk through the Google console before it could sell a coffee. Google's is
# the Web Client ID (the same value goes in every tenants/{slug}.json as
# GOOGLE_SERVER_CLIENT_ID, because the native apps ask for an id_token with
# that audience); Apple's is the Services ID and a client secret that expires,
# which rotate-apple-secret.yml renews. Empty leaves the providers off, and a
# stamped realm gets none at all rather than ones that cannot work.
# The native apps use these today; the browser flow needs a redirect URI per
# realm, which docs/social-auth-multi-tenant.md explains is not built yet.
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_APPLE_CLIENT_ID=
SOCIAL_APPLE_CLIENT_SECRET=

# Optional: a copy of every backup off the box. Any S3-compatible bucket:
# Backblaze B2, Cloudflare R2, Hetzner Object Storage, AWS S3. Keep the bucket
# private with server-side encryption and a 30-day lifecycle rule; the
# platform deletes a copy only when its backup is deleted here.
OFFSITE_ENDPOINT=
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
OFFSITE_REGION=auto
OFFSITE_PREFIX=

# Once a week, restore one tenant's latest backup into a scratch stack to
# prove it restores (needs a stack's worth of memory for ten minutes). On
# by default: a backup nobody has restored is a hope, not a backup.
RESTORE_DRILL_ENABLED=true

# What the shared Postgres allows, the most one tenant service's pool may
# open (its ceiling), and what one typically holds (what the control plane
# counts against max_connections before a stamp: eleven services a stack
# plus the platform's own forty), the floor on the tenants drive below
# which nothing is backed up or stamped, and the memory each shared
# service may take.
POSTGRES_MAX_CONNECTIONS=400
SERVICE_POOL_SIZE=20
SERVICE_CONNECTIONS_ESTIMATE=4
MIN_FREE_DISK_MB=5120
POSTGRES_MEMORY=3G
POSTGRES_SHARED_BUFFERS=1GB
KEYCLOAK_MEMORY=1536M
EVENTBUS_MEMORY=1G
CONTROL_MEMORY=768M
CADDY_MEMORY=256M

# Optional: mail. Any SMTP account (Resend, Brevo, SES, a Workspace mailbox):
# the owner's welcome with their first password, demo expiry warnings,
# subscription notices, and the ops mails to MAIL_OPS_TO (a failed stamp or
# backup). The realms get the same settings for their password resets. Empty
# MAIL_HOST leaves mail off; every mail that would have gone is audited.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_OPS_TO=

IMAGE_REGISTRY=ghcr.io/achmstein/ninja
# A release tag (vYYYY.MM.DD), never latest: latest to latest has nothing to
# roll back to, and a fleet upgrade needs a tag every service carries
IMAGE_TAG=v2026.09.22
# Only while the service packages are private: a user and a token that can
# read them (on GHCR, a PAT with read:packages). The control plane reads
# the registry to list releases and to tell which stacks run an older build.
REGISTRY_USER=
REGISTRY_TOKEN=
