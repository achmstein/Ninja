{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "AI": {
    // Any OpenAI-compatible provider: change these two. The key is the
    // "gemini-api-key" parameter: the dashboard asks for it on first run and
    // can remember it in user secrets; GEMINI_API_KEY in the environment works
    // too. It is never in this repo. "Enabled": false leaves the assistant out.
    "Enabled": true,
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "ChatModel": "gemini-2.5-flash"
  }
}
