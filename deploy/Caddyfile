# Caddy configuration for Chillax
#
# chillax.site        — static landing website
# api.chillax.site    — reverse proxy to mobile-bff (YARP)
# auth.chillax.site   — Keycloak (identity provider)
# admin.chillax.site  — admin web app (SPA) + BFF proxy
# app.chillax.site    — customer web app (SPA) + BFF proxy
#
# Caddy handles TLS termination (auto Let's Encrypt).

chillax.site {
	# Printed room and table QRs encode chillax.site/{room,table}/{id}; the
	# customer web app handles both flows at app.chillax.site. Installed apps
	# intercept these URLs as App Links before the redirect is followed.
	redir /room/* https://app.chillax.site{uri} permanent
	redir /table/* https://app.chillax.site{uri} permanent

	# App Links / Universal Links association files. Apple requires
	# application/json on an extensionless path.
	handle /.well-known/apple-app-site-association {
		header Content-Type application/json
		root * /srv/website
		file_server
	}

	root * /srv/website
	file_server
}

api.chillax.site {
	reverse_proxy mobile-bff:5000
}

# Dedicated identity host — straight to Keycloak, no BFF hop. Caddy sets
# X-Forwarded-Proto/Host itself, so Keycloak resolves public URLs correctly.
# (api.chillax.site/auth remains as a compatibility path for installed
# mobile apps.)
auth.chillax.site {
	reverse_proxy keycloak:8080
}

admin.chillax.site {
	handle /api/* {
		reverse_proxy mobile-bff:5000
	}
	handle /hub/* {
		reverse_proxy mobile-bff:5000
	}
	handle {
		root * /srv/admin-web
		try_files {path} /index.html
		file_server

		# Hashed bundles cache forever; index.html must revalidate so a
		# deploy reaches browsers immediately (heuristic caching otherwise
		# keeps stale bundles alive)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@nonassets not path /assets/*
		header @nonassets Cache-Control "no-cache"
	}
}

app.chillax.site {
	handle /api/* {
		reverse_proxy mobile-bff:5000
	}
	handle /hub/* {
		reverse_proxy mobile-bff:5000
	}
	handle {
		root * /srv/client-web
		try_files {path} /index.html
		file_server

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@nonassets not path /assets/*
		header @nonassets Cache-Control "no-cache"
	}
}
