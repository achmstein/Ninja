    "/api/orders/stats": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get aggregated order statistics (admin)",
        "description": "Per-day order counts/revenue and top items over a date range, excluding cancelled orders.",
        "operationId": "GetOrderStats",
        "parameters": [
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "tzOffsetMinutes",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "api-version",
            "in": "query",
