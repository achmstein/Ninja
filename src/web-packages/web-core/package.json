{
  "name": "@ninja/web-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What the web apps copied between them: session, cookies, brand fonts, branch claims. TypeScript source; each app compiles it as its own.",
  "exports": {
    "./branch-claim": "./src/branch-claim.ts",
    "./brand-fonts": "./src/brand-fonts.ts",
    "./cookies": "./src/cookies.ts",
    "./oidc": "./src/oidc.ts",
    "./push": "./src/push.ts",
    "./session": "./src/session.tsx",
    "./sound": "./src/sound.ts",
    "./theme": "./src/theme.tsx",
    "./toast": "./src/toast.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "firebase": "*",
    "oidc-client-ts": "*",
    "react": "*",
    "react-oidc-context": "*",
    "sileo": "*",
    "zustand": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@ninja/config": "*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase": "12.19.0",
    "globals": "^16.5.0",
    "oidc-client-ts": "3.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "19.3.1",
    "react-oidc-context": "3.3.1",
    "sileo": "0.1.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^5.0.1",
    "zustand": "5.0.15"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "sileo": {
      "optional": true
    }
