<Project Sdk="MSTest.Sdk">

  <!--
    Inventory.API through its front door, on the shared Postgres and
    RabbitMQ (tests/Ninja.Testing): the storeroom's items, what a delivery
    and a count do to what is on hand, and what a recipe costs.
    Needs docker, so it runs as its own PR job.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inventory.API\Inventory.API.csproj" />
    <ProjectReference Include="..\Ninja.Testing\Ninja.Testing.csproj" />
  </ItemGroup>

</Project>
