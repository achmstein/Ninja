# The platform's shared secrets and its domain. Copy to .env and fill in.

# Tenants hang off this: {slug}.DOMAIN, admin.{slug}.DOMAIN, auth.DOMAIN, control.DOMAIN
PLATFORM_DOMAIN=ninja.app
# Which host label is the slug, counted from the right: 2 for a two-label
# domain (ninja.app), 3 for a three-label one (ninja.co.uk)
PLATFORM_SLUG_LABEL=2
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=
EVENTBUS_PASSWORD=
KEYCLOAK_PASSWORD=

# Optional: the assistant in every stack
GEMINI_API_KEY=

# Optional: a copy of every backup off the box. Any S3-compatible bucket:
# Backblaze B2, Cloudflare R2, Hetzner Object Storage, AWS S3. Keep the bucket
# private with server-side encryption and a 30-day lifecycle rule; the
# platform deletes a copy only when its backup is deleted here.
OFFSITE_ENDPOINT=
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
OFFSITE_REGION=auto
OFFSITE_PREFIX=

# Optional: once a week, restore one tenant's latest backup into a scratch
# stack to prove it restores (needs a stack's worth of memory for ten minutes)
RESTORE_DRILL_ENABLED=false

# Optional: mail. Any SMTP account (Resend, Brevo, SES, a Workspace mailbox):
# the owner's welcome with their first password, demo expiry warnings,
# subscription notices, and the ops mails to MAIL_OPS_TO (a failed stamp or
# backup). The realms get the same settings for their password resets. Empty
# MAIL_HOST leaves mail off; every mail that would have gone is audited.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_OPS_TO=

IMAGE_REGISTRY=ghcr.io/achmstein/ninja
IMAGE_TAG=latest
# Only while the service packages are private: a user and a token that can
# read them (on GHCR, a PAT with read:packages). The control plane reads
# the registry to list releases and to tell which stacks run an older build.
REGISTRY_USER=
REGISTRY_TOKEN=
