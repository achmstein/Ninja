default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci if ENV['CI']

    # The business's own app and team when the build was stamped for one (tool/stamp_tenant.dart)
    app_id = ENV["APP_ID"] || "com.chillax.client"
    extension_id = "#{app_id}.ChillaxLiveActivity"
    team_id = ENV["APPLE_TEAM_ID"] || "NT4VMTB8MK"

    match(
      type: "appstore",
      app_identifier: [app_id, extension_id],
      team_id: team_id,
      readonly: is_ci,
      api_key_path: ENV["API_KEY_PATH"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: team_id,
      bundle_identifier: app_id,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{app_id}_appstore_profile-name"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: team_id,
      bundle_identifier: extension_id,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{extension_id}_appstore_profile-name"],
      targets: ["ChillaxLiveActivity"],
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
    )

    upload_to_testflight(
      api_key_path: ENV["API_KEY_PATH"],
      skip_waiting_for_build_processing: true,
    )
  end

  lane :upload_metadata do
    deliver(
      api_key_path: ENV["API_KEY_PATH"],
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      submit_for_review: false,
    )
  end
end
