  "components": {
    "schemas": {
      "BasketItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "productName": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "oldUnitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pictureUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "specialInstructions": {
            "type": [
              "null",
              "string"
            ]
          },
          "selectedCustomizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItemCustomization"
            }
          },
          "totalPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BasketItemCustomization": {
        "type": "object",
        "properties": {
          "customizationId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "customizationName": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "optionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "optionName": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "priceAdjustment": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CancelOrderCommand": {
        "required": [
          "orderNumber"
        ],
        "type": "object",
        "properties": {
          "orderNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ConfirmOrderCommand": {
        "required": [
          "orderNumber"
        ],
        "type": "object",
        "properties": {
          "orderNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateOrderDraftCommand": {
        "required": [
          "buyerId",
          "items"
        ],
        "type": "object",
        "properties": {
          "buyerId": {
            "type": [
              "null",
              "string"
            ]
          },
          "items": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            }
          }
        }
      },
      "CreateOrderRequest": {
        "required": [
          "userId",
          "userName",
          "roomName",
          "customerNote",
          "pointsToRedeem",
          "loyaltyDiscount",
          "items"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "roomName": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "customerNote": {
            "type": [
              "null",
              "string"
            ]
          },
          "pointsToRedeem": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "loyaltyDiscount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            }
          }
        }
      },
      "LocalizedText": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string"
          },
          "ar": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "roomName": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "customerNote": {
            "type": [
              "null",
              "string"
            ]
          },
          "orderItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Orderitem"
            }
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
