  "components": {
    "schemas": {
      "BrandDto": {
        "required": [
          "name",
          "primaryColor",
          "customerUrl",
          "logoUrl",
          "logoDarkUrl",
          "wordmarks",
          "theme",
          "icons",
          "features",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/BrandText"
          },
          "primaryColor": {
            "type": [
              "null",
              "string"
            ]
          },
          "customerUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "logoDarkUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "wordmarks": {
            "$ref": "#/components/schemas/BrandWordmarks"
          },
          "theme": {
            "$ref": "#/components/schemas/BrandTheme"
          },
          "icons": {
            "$ref": "#/components/schemas/BrandIcons"
          },
          "features": {
            "$ref": "#/components/schemas/BrandFeatures"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "BrandFeatures": {
        "required": [
          "rooms",
          "loyalty",
          "tabs",
          "inventory",
          "finance",
          "payroll",
          "kds"
        ],
        "type": "object",
        "properties": {
          "rooms": {
            "type": "boolean"
          },
          "loyalty": {
            "type": "boolean"
          },
          "tabs": {
            "type": "boolean"
          },
          "inventory": {
            "type": "boolean"
          },
          "finance": {
            "type": "boolean"
          },
          "payroll": {
            "type": "boolean"
          },
          "kds": {
            "type": "boolean"
          }
        }
      },
      "BrandIcons": {
        "required": [
          "icon192",
          "icon512",
          "maskable512",
          "appleTouch",
          "favicon"
        ],
        "type": "object",
        "properties": {
          "icon192": {
            "type": "string"
          },
          "icon512": {
            "type": "string"
          },
          "maskable512": {
            "type": "string"
          },
          "appleTouch": {
            "type": "string"
          },
          "favicon": {
            "type": "string"
          }
        }
      },
      "BrandText": {
        "required": [
          "en",
          "ar"
        ],
        "type": "object",
        "properties": {
          "en": {
            "type": "string"
          },
          "ar": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BrandTheme": {
        "required": [
          "accent",
          "background",
          "foreground",
          "radius",
          "font"
        ],
        "type": "object",
        "properties": {
          "accent": {
            "type": [
              "null",
              "string"
            ]
          },
          "background": {
