<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6453341">
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <!-- Keep `dotnet build` fast; the production bundle is built by npm/CI, not MSBuild -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
  </PropertyGroup>
</Project>
