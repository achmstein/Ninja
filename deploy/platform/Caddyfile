# The platform's edge. One Caddy for every tenant: it routes by host label
# to the tenant's own gateway and issues certificates on demand, asking the
# control plane first so only hosts we know get one. Wildcard DNS
# (*.{$PLATFORM_DOMAIN} and *.*.{$PLATFORM_DOMAIN} → this box) is the only
# thing a new tenant needs outside this compose project.
#
# Host scheme, with PLATFORM_DOMAIN=ninja.app:
#   ninja.app                → the platform's site (control redirect for now); /apps is the
#                              download page for the native till and kitchen apps
#   auth.ninja.app           → Keycloak, every realm
#   control.ninja.app        → the control app + its API
#   {slug}.ninja.app         → the café's customer app, served from the shared build
#   admin|pos|kds.{slug}.ninja.app → the staff apps, shared builds
#   api.{slug}.ninja.app     → the tenant's gateway, for the native apps
# A café's own domain (menu.cafe.com) is mapped to its slug in
# custom-domains.caddy, which the control plane rewrites and reloads.
#
# {labels.N} counts from the right: for admin.blue.ninja.app, labels.0=app,
# labels.1=ninja, labels.2=blue. A platform domain with three labels shifts
# every index by one; PLATFORM_SLUG_LABEL carries that number (2 for a
# two-label domain, 3 for co.uk-style).

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://control-api:8080/api/control/tls/ask
	}
}

(spa) {
	# args: root
	root * {args[0]}
	try_files {path} /index.html
	file_server
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@nonassets not path /assets/*
	header @nonassets Cache-Control "no-cache"
}

(tenant_api) {
	# args: the tenant's gateway host
	handle /api/* {
		reverse_proxy {args[0]}:5000
	}
	handle /hub/* {
		reverse_proxy {args[0]}:5000
	}
}

# A stack that is off (suspended for non-payment, or stopped) answers nothing: say so,
# as JSON the apps recognise, instead of a bare 502. It sits at the site level
# and not in (tenant_api), because handle_errors is not an ordered handler and
# so cannot be imported inside a handle block.
(paused_api) {
	handle_errors 502 503 {
		@apipath path /api/* /hub/*
		handle @apipath {
			header Content-Type application/json
			respond `{"code":"paused"}` 503
		}
	}
}

{$PLATFORM_DOMAIN} {
	# The native apps: one generic build of each, published here by mobile-deploy.yml;
	# a tablet installs from this page and connects to its café from inside the app
	handle_path /apps* {
		root * /srv/apps
		file_server
		# The APKs and their version notes change under the same name; never a stale copy
		header Cache-Control "no-cache"
		# Android installs what it is told is a package; an unknown type would just be a file
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
	}
	handle {
		redir https://control.{$PLATFORM_DOMAIN}{uri}
	}
}

auth.{$PLATFORM_DOMAIN} {
	# "Sign in as the owner": the control plane hands the owner's session
	# cookies to the browser from this host, where they belong
	handle /api/control/impersonate/* {
		reverse_proxy control-api:8080
	}
	# The admin console and the admin REST API: only from ADMIN_ALLOW_CIDR
	# (space-separated networks; nothing is allowed until it is set). The
	# control plane talks to Keycloak inside the docker network, not here.
	@console path /admin/*
	handle @console {
		@allowed remote_ip {$ADMIN_ALLOW_CIDR:127.0.0.1/32}
		handle @allowed {
			reverse_proxy keycloak:8080
		}
		respond "The Keycloak admin console is not reachable from here." 403
	}
	handle {
		reverse_proxy keycloak:8080
	}
}

control.{$PLATFORM_DOMAIN} {
	handle /api/* {
		reverse_proxy control-api:8080
	}
	handle {
		import spa /srv/control-web
	}
}

# Cafés on their own domains: the map fills {slug} from the host
import custom-domains.caddy

# The staff apps and the native apps' API host, two labels deep:
# admin|pos|kds|api.{slug}.{domain}.
#
# One site block with host matchers, not four blocks. A wildcard in a site
# address has to be the leftmost label -- Caddy refuses to adapt a config
# with `admin.*.{domain}` in one ("subject does not qualify for
# certificate"), on every version from 2.7 to 2.11, on_demand or not. Two
# leftmost wildcards are fine, and the matchers sort the hosts out inside.
# deploy/platform/local/Caddyfile does the same thing with one `https://`.
https://*.*.{$PLATFORM_DOMAIN} {
	tls {
		on_demand
	}

	@admin host admin.*.{$PLATFORM_DOMAIN}
	handle @admin {
		import tenant_api {labels.{$PLATFORM_SLUG_LABEL}}-gateway
		handle {
			import spa /srv/admin-web
		}
	}

	@pos host pos.*.{$PLATFORM_DOMAIN}
	handle @pos {
		import tenant_api {labels.{$PLATFORM_SLUG_LABEL}}-gateway
		handle {
			import spa /srv/pos-web
		}
	}

	@kds host kds.*.{$PLATFORM_DOMAIN}
	handle @kds {
		import tenant_api {labels.{$PLATFORM_SLUG_LABEL}}-gateway
		handle {
			import spa /srv/kds-web
		}
	}

	# The native apps' API host
	@api host api.*.{$PLATFORM_DOMAIN}
	handle @api {
		reverse_proxy {labels.{$PLATFORM_SLUG_LABEL}}-gateway:5000
	}

	# Two labels deep and none of the four: nothing here answers for it
	handle {
		respond 404
	}

	# The staff apps proxy /api/* and /hub/*; on the API host every path is one,
	# so the native apps hear the same word as the web ones either way
	handle_errors 502 503 {
		@apihost host api.*.{$PLATFORM_DOMAIN}
		handle @apihost {
			header Content-Type application/json
			respond `{"code":"paused"}` 503
		}
		@apipath path /api/* /hub/*
		handle @apipath {
			header Content-Type application/json
			respond `{"code":"paused"}` 503
		}
	}
}

# The customer app on the platform host: {slug}.{domain}. Only the control
# app and the café's own admin may frame it (their live brand previews).
https://*.{$PLATFORM_DOMAIN} {
	tls {
		on_demand
	}
	header Content-Security-Policy "frame-ancestors 'self' https://control.{$PLATFORM_DOMAIN} https://admin.{host}"
	import tenant_api {labels.{$PLATFORM_SLUG_LABEL}}-gateway
	handle {
		import spa /srv/client-web
	}
	import paused_api
}
