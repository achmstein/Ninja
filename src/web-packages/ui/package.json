{
  "name": "@ninja/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Components the staff apps shared by copying: the Ninja wordmark, the boot splash. TypeScript source; each app compiles it and lists src/ as a Tailwind source.",
  "exports": {
    "./boot-splash": "./src/boot-splash.tsx",
    "./ninja-wordmark": "./src/ninja-wordmark.tsx",
    "./platform": "./src/platform.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ninja/web-core": "*"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@ninja/config": "*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/react": "^19.2.7",
    "clsx": "2.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "19.3.1",
    "tailwind-merge": "3.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^5.0.1",
    "zustand": "5.0.15"
  }
}
