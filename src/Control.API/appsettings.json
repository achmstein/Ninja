{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Endpoint": {
      "Name": "Control.API V1"
    },
    "Document": {
      "Description": "The Ninja control plane: tenants, demos, provisioning.",
      "Title": "Ninja - Control HTTP API",
      "Version": "v1"
    }
  },
  "Identity": {
    "Audience": "control",
    "Scopes": {
      "control": "Control API"
    }
  },
  "Platform": {
    "Domain": "ninja.local",
    "ControlUrl": "http://localhost:5177",
    "TenantsRoot": "/opt/ninja/tenants",
    "ImageRegistry": "ghcr.io/achmstein/ninja",
    "DefaultImageTag": "latest",
    "DemoDays": 14,
    "DemoGraceDays": 7,
    "DryRun": false
  }
}
