<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-service end-to-end workflow tests. Boots the real AppHost in test
    mode (Chillax:TestMode=true — ephemeral containers, random ports, no web
    apps) through Aspire.Hosting.Testing, drives the services through the BFF
    with the same calls the React apps make and asserts every downstream
    effect: projections, bus traffic, outbox rows, hub pushes, service logs.
    Needs Docker. Not part of Chillax.Web.slnf on purpose (CI stays Docker-free).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Same transitive-audit suppression as the root Directory.Build.props (tests/ has its own props file) -->
    <NoWarn>NU1901;NU1902;NU1903;NU1904</NoWarn>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>Chillax.E2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings the generated Projects.Chillax_AppHost and transitively builds the 12 APIs -->
    <ProjectReference Include="..\..\src\Chillax.AppHost\Chillax.AppHost.csproj" />
  </ItemGroup>

</Project>
