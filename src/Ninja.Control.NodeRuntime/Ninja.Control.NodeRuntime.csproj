<Project Sdk="Microsoft.NET.Sdk">

  <!-- What runs on a node: docker compose for its stacks, its Postgres and broker, its volumes and images.
       The control plane runs it in-process for the box it lives on; the node agent runs it on every other box. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ninja.Control.NodeRuntime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Control.UnitTests" />
    <InternalsVisibleTo Include="Ninja.Control.NodeRuntime.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
