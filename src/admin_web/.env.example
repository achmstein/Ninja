# Injected automatically by the Aspire AppHost in development.
# Only needed when running the dev server standalone.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chillax
# Where the customer app runs: the brand page frames it in a phone, and QR
# codes point at it until the brand names its own URL. Left out of the
# platform build, where it is this host without its `admin.` label.
VITE_CUSTOMER_URL=http://localhost:5174

# Firebase web push (optional — the app works without it; the push toggle in
# the profile menu simply stays hidden). Create a *Web app* in the same
# Firebase project Notification.API uses, then copy its config here, plus a
# Web Push certificate (VAPID) key from Project settings → Cloud Messaging.
# In production these come from the FIREBASE_WEB_* repository secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
