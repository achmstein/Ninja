{
  "openapi": "3.1.1",
  "info": {
    "title": "Branch.API | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/branches": {
      "get": {
        "tags": [
          "Branches"
        ],
        "summary": "List active branches",
        "operationId": "GetBranches",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BranchResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Branches"
        ],
        "summary": "Create a branch",
        "operationId": "CreateBranch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBranchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/branches/all": {
      "get": {
        "tags": [
          "Branches"
        ],
        "summary": "List all branches including inactive",
        "operationId": "GetAllBranches",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BranchResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/branches/{id}": {
      "put": {
        "tags": [
          "Branches"
        ],
        "summary": "Update a branch",
        "operationId": "UpdateBranch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The branch ID",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBranchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/branches/{branchId}/settings": {
      "patch": {
        "tags": [
          "Branches"
        ],
        "summary": "Update branch operational settings (ordering, reservations)",
        "operationId": "UpdateBranchSettings",
        "parameters": [
          {
            "name": "branchId",
            "in": "path",
            "description": "The branch ID",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBranchSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BranchResponse": {
        "required": [
          "id",
          "name",
          "address",
          "phone",
          "taxNumber",
          "receiptFooter",
          "isActive",
          "displayOrder",
          "dayStartTime",
          "dayEndTime",
          "isOrderingEnabled",
          "isReservationsEnabled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "address": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "taxNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "receiptFooter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "displayOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "dayStartTime": {
            "type": "string"
          },
          "dayEndTime": {
            "type": "string"
          },
          "isOrderingEnabled": {
            "type": "boolean"
          },
          "isReservationsEnabled": {
            "type": "boolean"
          }
        }
      },
      "CreateBranchRequest": {
        "required": [
          "name",
          "address",
          "phone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "address": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 0
          },
          "taxNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "receiptFooter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "dayStartTime": {
            "type": [
              "null",
              "string"
            ]
          },
          "dayEndTime": {
            "type": [
              "null",
              "string"
            ]
          },
          "isOrderingEnabled": {
            "type": "boolean",
            "default": true
          },
          "isReservationsEnabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "LocalizedText": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string"
          },
          "ar": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateBranchRequest": {
        "required": [
          "name",
          "address",
          "phone",
          "isActive",
          "displayOrder"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "address": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "displayOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "taxNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "receiptFooter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocalizedText"
              }
            ]
          },
          "dayStartTime": {
            "type": [
              "null",
              "string"
            ]
          },
          "dayEndTime": {
            "type": [
              "null",
              "string"
            ]
          },
          "isOrderingEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "isReservationsEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "UpdateBranchSettingsRequest": {
        "type": "object",
        "properties": {
          "isOrderingEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "isReservationsEnabled": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Branches"
    }
  ]
}