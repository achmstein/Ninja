{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Endpoint": {
      "Name": "Tenant.API V1"
    },
    "Document": {
      "Description": "The Tenant Microservice HTTP API: the café's own record and its branches.",
      "Title": "Ninja - Tenant HTTP API",
      "Version": "v1"
    }
  },
  "ConnectionStrings": {
    "EventBus": "amqp://localhost"
  },
  "EventBus": {
    "SubscriptionClientName": "Tenant"
  },
  "Identity": {
    "Audience": "branches",
    "Scopes": {
      "branches": "Branches API"
    }
  }
}
