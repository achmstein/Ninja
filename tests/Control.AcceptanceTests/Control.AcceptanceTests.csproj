<Project Sdk="MSTest.Sdk">

  <!--
    The platform on a real docker host: the control plane at
    https://control.localhost stamps a throwaway café, and the assertions are
    the box itself — docker ps, rabbitmqctl, a probe through the tenant's
    gateway. This is the one suite that can prove the containers obeyed; the
    functional suite proves the plane decided correctly.

    Opt-in: nothing runs unless NINJA_ACCEPTANCE=1, because it needs
    deploy/platform/local up and takes minutes. Not in any solution filter
    and not in the PR workflow; run it by hand or nightly:

      $env:NINJA_ACCEPTANCE=1; dotnet test tests/Control.AcceptanceTests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Control.API\Control.API.csproj" />
  </ItemGroup>

</Project>
