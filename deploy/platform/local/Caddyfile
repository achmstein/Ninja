# The edge on a laptop: the production routing with Caddy's own local CA
# issuing an exact certificate per host on its first connection. Keycloak
# only sets Secure cookies, so plain http cannot sign anyone in; trust the
# CA once (see README). Browsers reject a wildcard directly under a
# top-level name (*.localhost), so no wildcard site addresses here: one
# catch-all site with host matchers, and the control plane confirms each
# host is one of ours before a certificate is issued, as in production.
# {labels.1} is the slug in admin.cove.localhost (labels.0 = localhost).

{
	local_certs
	on_demand_tls {
		ask http://control-api:8080/api/control/tls/ask
	}
}

(spa) {
	root * {args[0]}
	try_files {path} /index.html
	file_server
	header Cache-Control "no-cache"
}

(tenant_api) {
	handle /api/* {
		reverse_proxy {args[0]}:5000
	}
	handle /hub/* {
		reverse_proxy {args[0]}:5000
	}
}

https:// {
	tls {
		on_demand
	}

	@root host localhost
	handle @root {
		redir https://control.localhost{uri}
	}

	@auth host auth.localhost
	handle @auth {
		reverse_proxy keycloak:8080
	}

	@control host control.localhost
	handle @control {
		handle /api/* {
			reverse_proxy control-api:8080
		}
		handle {
			import spa /srv/control-web
		}
	}

	@admin host admin.*.localhost
	handle @admin {
		import tenant_api {labels.1}-gateway
		handle {
			import spa /srv/admin-web
		}
	}

	@pos host pos.*.localhost
	handle @pos {
		import tenant_api {labels.1}-gateway
		handle {
			import spa /srv/pos-web
		}
	}

	@kds host kds.*.localhost
	handle @kds {
		import tenant_api {labels.1}-gateway
		handle {
			import spa /srv/kds-web
		}
	}

	@api host api.*.localhost
	handle @api {
		reverse_proxy {labels.1}-gateway:5000
	}

	# The customer app on the platform host is the catch-all; only the
	# control app may frame it (its live brand preview)
	@customer host *.localhost
	handle @customer {
		header Content-Security-Policy "frame-ancestors 'self' https://control.localhost"
		import tenant_api {labels.1}-gateway
		handle {
			import spa /srv/client-web
		}
	}
}
