  "components": {
    "schemas": {
      "AddLineRequest": {
        "required": [
          "description",
          "qty",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "description": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "qty": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "discount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double",
            "default": 0
          }
        }
      },
      "CashMovementRequest": {
        "required": [
          "type",
          "amount",
          "reason"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/CashMovementType"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "CashMovementType": {
        "type": "integer"
      },
      "CashMovementView": {
        "required": [
          "type",
          "amount",
          "reason",
          "recordedBy",
          "recordedAt"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "reason": {
            "type": "string"
          },
          "recordedBy": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CloseShiftRequest": {
        "required": [
          "closingCount"
        ],
        "type": "object",
        "properties": {
          "closingCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "LocalizedText": {
