      "name": "Owner's assistant (chat apps)",
      "description": "Pre-registered public client for chat apps that do not register themselves (Claude Code, a connector's advanced settings). Claude.ai and ChatGPT register their own.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://claude.ai/api/mcp/auth_callback",
        "http://localhost:8765/callback",
        "http://127.0.0.1:8765/callback"
      ],
      "webOrigins": [],
      "consentRequired": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "branches",
        "mcp"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "assistant-api",
      "name": "Assistant service (token exchange)",
      "description": "Assistant.API exchanges a chat app's token (audience: this client) for its own before calling the other services (RFC 8693).",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "secret": "{{assistantSecret}}",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "branches"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "standard.token.exchange.enabled": "true"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-identity-api-service",
      "enabled": true,
      "serviceAccountClientId": "identity-api-service",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm",
          "manage-realm"
        ]
      }
    },
    {
      "username": "service-account-ninja-control",
      "enabled": true,
      "serviceAccountClientId": "ninja-control",
      "realmRoles": [
        "Owner",
        "Admin"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm",
          "manage-realm"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "subComponents": {},
        "config": {
          "trusted-hosts": [ "chatgpt.com", "*.chatgpt.com", "openai.com", "*.openai.com", "*.oaistatic.com", "*.oaiusercontent.com", "claude.ai", "*.claude.ai", "anthropic.com", "*.anthropic.com" ],
          "host-sending-registration-request-must-match": [ "false" ],
          "client-uris-must-match": [ "true" ]
        }
