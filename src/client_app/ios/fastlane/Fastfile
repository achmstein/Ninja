default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci if ENV['CI']

    # One-off: regenerate the App Store provisioning profiles so they pick up
    # the current App ID capabilities (the associated-domains entitlement for
    # App Links was missing from the stored profile). Revert to
    # `readonly: is_ci` once the profiles are regenerated and stored.
    match(
      type: "appstore",
      app_identifier: ["com.chillax.client", "com.chillax.client.ChillaxLiveActivity"],
      readonly: false,
      force: true,
      api_key_path: ENV["API_KEY_PATH"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "NT4VMTB8MK",
      bundle_identifier: "com.chillax.client",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_com.chillax.client_appstore_profile-name"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "NT4VMTB8MK",
      bundle_identifier: "com.chillax.client.ChillaxLiveActivity",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_com.chillax.client.ChillaxLiveActivity_appstore_profile-name"],
      targets: ["ChillaxLiveActivity"],
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
    )

    upload_to_testflight(
      api_key_path: ENV["API_KEY_PATH"],
      skip_waiting_for_build_processing: true,
    )
  end

  lane :upload_metadata do
    deliver(
      api_key_path: ENV["API_KEY_PATH"],
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      submit_for_review: false,
    )
  end
end
