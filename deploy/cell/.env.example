# A cell's settings; .github/workflows/setup-node.yml writes .env from these.
# Made once on the node and kept:
POSTGRES_PASSWORD=
EVENTBUS_PASSWORD=
AGENT_CERT_PASSWORD=
# Set on every run:
WG_IP=10.66.0.2
AGENT_TAG=latest
IMAGE_REGISTRY=ghcr.io/achmstein/ninja
# The control plane's client certificate, SHA-256, no colons: the only one the agent answers
CONTROL_PLANE_THUMBPRINT=
# Optional
POSTGRES_MAX_CONNECTIONS=400
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_MEMORY=3G
EVENTBUS_MEMORY=1G
PLATFORM_SLUG_LABEL=2
